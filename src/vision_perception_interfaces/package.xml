<?xml version="1.0"?>
<package format="3">
  <name>vision_perception_interfaces</name>
  <version>0.1.2</version>
  <description>
    Arm-independent vision observation contracts (plan section 3):
    VisionDetection2D/Array for V1; VisionObject/Array frozen for future V2/V3.
    Publishing /dg/vision/objects requires separate authorization.
  </description>
  <maintainer email="206929594+liaojingwu20041031@users.noreply.github.com">liaojingwu20041031</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>vision_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
